# Copy this file to .env and fill in real values. Never commit .env
# itself (it's already in .gitignore) — only this example file belongs
# in git. Vite only exposes vars prefixed VITE_ to browser code — this
# is Vite's own safety boundary so a server secret can never accidentally
# end up in the frontend bundle.

# Same OAuth client ID as backend/.env.example's GOOGLE_OAUTH_CLIENT_ID —
# Google Identity Services needs it in the browser to render the sign-in
# button and request the Photos Picker scope.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Where the Express backend is reachable. http://localhost:8080 for
# local development (see backend/.env.example's PORT); the deployed
# Cloud Run URL in production.
VITE_API_BASE_URL=http://localhost:8080
