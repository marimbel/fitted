# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore) — only this example file with placeholder
# names belongs in git.

# Google Cloud project this backend talks to (Firestore, etc.)
GCP_PROJECT_ID=

# Vertex AI region for StyleScout's visual-similarity search
# (services/embeddingsService.js -- multimodal embeddings model).
# Same GCP_PROJECT_ID above must have the Vertex AI API enabled and
# billing active, and the account/service account needs the
# "Vertex AI User" IAM role.
VERTEX_LOCATION=us-central1

# Model id for Vertex AI's Virtual Try-On model (services/
# virtualTryOnService.js). Defaults to "virtual-try-on-001" in code if
# left unset here -- only set this if your project/region still serves
# it under a different (e.g. dated preview) name.
# VERTEX_VTO_MODEL=virtual-try-on-001

# OAuth client ID from Google Cloud Console (Credentials > OAuth 2.0 Client
# IDs). Used both by the frontend (Google Identity Services sign-in) and
# here on the backend to verify the ID tokens it receives.
GOOGLE_OAUTH_CLIENT_ID=

# Gemini API key from https://aistudio.google.com/apikey
# TODO (per the proposal response): verify this exact model name in AI
# Studio before the demo — do not hard-code a model ID anywhere else in
# the codebase, always read it from this env var.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Model id for Gemini's IMAGE-generation output (services/
# imaginedAngleService.js -- the Fitting Room's "AI-imagined" side/back
# view). Different from GEMINI_MODEL above, which is text/JSON-only.
# Defaults to "gemini-2.5-flash-image" in code if left unset -- verify
# this is still a valid, available model id in AI Studio before the
# demo, same caveat as GEMINI_MODEL.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Same GA4 property as the frontend's VITE_GA4_MEASUREMENT_ID (Google
# Analytics > Admin > Data Streams > your web stream > Measurement ID).
GA4_MEASUREMENT_ID=

# Measurement Protocol API secret for that same GA4 property (Admin >
# Data Streams > your web stream > Measurement Protocol API secrets >
# Create). Unlike the Measurement ID, THIS one is a real secret --
# anyone with it can send fake events into your GA4 property -- so it
# stays backend-only, never in a frontend env file.
GA4_API_SECRET=

# Port Express listens on locally. Cloud Run supplies its own PORT env var
# at deploy time, which server.js should prefer when present.
PORT=8080
