# Loaded automatically by Vite during `npm run build` (production mode),
# on top of (and overriding) .env. Unlike .env, this file is committed to
# git: an OAuth Client ID is meant to be public -- it's embedded in every
# browser's JS bundle regardless, Google's servers are what actually
# enforce anything with it (via the authorized JS origins configured on
# the client) -- so there's no secret here to protect.
#
# The actual secrets (GEMINI_API_KEY, GOOGLE_OAUTH_CLIENT_SECRET,
# GCP_PROJECT_ID) never go in a frontend env file at all -- they're
# backend-only and set directly on the Cloud Run service at deploy time
# (see the root Dockerfile and README's Docker Deployment section).
VITE_GOOGLE_OAUTH_CLIENT_ID=254620344303-a2ccq24b9qvfhb27rm2n9tkloi74d4eu.apps.googleusercontent.com

# Left blank on purpose: in production the backend serves the built
# frontend from the same Cloud Run service/origin, so relative paths
# (e.g. fetch("/api/...")) just work -- see src/services/apiClient.js.
VITE_API_BASE_URL=

# Same reasoning as VITE_GOOGLE_OAUTH_CLIENT_ID above: a GA4 Measurement
# ID is meant to be public. Fill in once the GA4 property exists.
VITE_GA4_MEASUREMENT_ID=
